# Database
DATABASE_URL="postgresql://grc:grc_dev_password@localhost:5432/grc_platform"

# NextAuth
# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Do NOT commit a real secret. Do NOT reuse this placeholder — the app will refuse to start in production.
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
# Hours a login stays valid before signing in again (default 12, max 720).
SESSION_MAX_AGE_HOURS="12"

# Microsoft Entra ID (Azure AD) SSO (optional — leave blank to disable)
# TENANT_ID must be your organisation's tenant GUID; "common"/"organizations" are refused because
# SSO auto-creates Viewer accounts for anyone who can sign in.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# GCP Cloud Storage (optional — falls back to local filesystem)
GCS_BUCKET=""
GCS_KEY_FILE=""

# Outgoing email: required in production (Trust Center links and codes, admin alerts, vendor portal, email MFA).
# In development, leaving SMTP_HOST empty prints emails to the server log instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="grc@yourcompany.com"

# Development only: shows the demo login hint on the sign-in page. Never enable in production.
DEMO_MODE="false"

# Docker Compose only: password for the bundled Postgres. Set before the first start.
POSTGRES_PASSWORD="grc_dev_password"

# Docker Compose `https` profile: the domain Caddy gets a certificate for (DNS must point here).
DOMAIN=""
# Set to 127.0.0.1 when a reverse proxy is the only way in (recommended with the https profile).
APP_BIND="0.0.0.0"

# Folder for uploaded files when GCS_BUCKET is empty (default: ./uploads; Docker: /app/uploads).
UPLOAD_DIR=""

# Evidence reminders (configured per organisation in Settings → Organization).
# Hour of day (UTC) reminders go out; 3 = 08:30 IST / 04:00 CET.
REMINDER_HOUR_UTC="3"
# Set to "true" to stop this server instance sending reminders (e.g. a second replica, or tests).
REMINDERS_DISABLED="false"
